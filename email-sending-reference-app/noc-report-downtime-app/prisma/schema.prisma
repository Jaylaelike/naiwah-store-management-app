generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Main downtime report table
model MainDb {
  id                Int       @id @default(autoincrement())
  Site              String
  FacilityProvider  String
  EngineeringCenter String
  PostingDate       DateTime
  DowntimeStart     DateTime
  DowntimeEnd       DateTime
  DowntimeTotal     String
  Detail            String
  JobTickets        String
  Reporter          String
  Approver          String?
  Remark            String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  @@map("maindbs")
}

// User authentication table
model User {
  id             String    @id @default(cuid())
  username       String    @unique
  role           String    @default("user")
  hashedPassword String    @map("hashed_password")
  email          String?   @unique
  emailVerified  DateTime? @map("email_verified")
  image          String?
  accounts       Account[]
  sessions       Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Reporter users list
model Reporter {
  id               Int    @id @default(autoincrement())
  usernameReporter String @map("username_reporter")

  @@map("reporters")
}

// Email settings for notifications
model EmailSetting {
  id         Int    @id @default(autoincrement())
  enterprise String
  username   String @unique
  telephone  String
  emails     String

  @@map("email_settings")
}

// CC Email settings
model CCEmailSetting {
  id           Int    @id @default(autoincrement())
  enterpriseCc String @map("enterprise_cc")
  usernameCc   String @unique @map("username_cc")
  telephoneCc  String @map("telephone_cc")
  emailsCc     String @map("emails_cc")

  @@map("cc_email_settings")
}
